#!/bin/sh
# Names XENIO as co-author of every commit made in this repository, so GitHub shows its mark (@xenio101) next to yours.
# Switch it on once per clone:  git config core.hooksPath .githooks
# XENIO_GIT_EMAIL / XENIO_GIT_NAME change the line; XENIO_NO_COAUTHOR=1 leaves it out of one commit.
[ "${XENIO_NO_COAUTHOR:-}" = "1" ] && exit 0
case "$2" in merge|squash) exit 0 ;; esac
name="${XENIO_GIT_NAME:-XENIO}"
email="${XENIO_GIT_EMAIL:-xenio0120@gmail.com}"
grep -qi "^Co-Authored-By: $name <$email>" "$1" && exit 0
git interpret-trailers --in-place --if-exists addIfDifferent --trailer "Co-Authored-By: $name <$email>" "$1"
