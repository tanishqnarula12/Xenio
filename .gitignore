# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Runtime data (logs, recordings, downloaded models)
data/
logs/
*.wav
*.mp3

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Google OAuth client files and tokens (contain client secrets)
user_required_steps/
client_secret*.json
*credentials*.json
google_token.json

# UI V1 (ui/): dependencies and the build (`npm install && npm run build` in ui/)
ui/node_modules/
ui/dist/

# TypeScript incremental build cache
*.tsbuildinfo

# Built native helpers (from native/*/build.sh)
native/build/

# tools run from the repository root
/node_modules/

# The original, full-size screen recording (over GitHub's 100 MB limit, and unblurred). The repo has docs/media/xenio-demo.mp4.
/xenio .mp4
*.mov

# Coding-assistant skill packs installed on this machine (`npx skills add`): local tooling, not part of XENIO
/.agents/
/.claude/
/.hermes/
/skills-lock.json
# gsap installed at the root for experiments; the interface has its own in ui/
/package.json
/package-lock.json
/node_modules/
# Design images saved from Figma runs
/native/figma-plugin/*.png
