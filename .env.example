# XENIO configuration. Copy to .env and fill in the two keys.
#   copy .env.example .env        (Windows)
# .env is git-ignored. Never put keys anywhere else.

XENIO_NAME=Xenio

# --- Speech-to-text (required for voice mode) -----------------------------------
# Any OpenAI-compatible /audio/transcriptions endpoint. Default: nabh.cloud Whisper.
STT_API_KEY=PASTE_YOUR_KEY_HERE
STT_API_URL=https://api.nabh.cloud/v1/models/whisper-large-v3-turbo/audio/transcriptions
STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=en              # blank = auto-detect; "en" stops accented English being taken for Hindi
# STT_TIMEOUT=30
# STT_MAX_RETRIES=2

# --- Text-to-speech (required for spoken replies) ---------------------------------
# Any OpenAI-compatible /audio/speech endpoint that can return WAV. Default: nabh.cloud Kokoro.
TTS_API_KEY=PASTE_YOUR_KEY_HERE
TTS_API_URL=https://api.nabh.cloud/v1/models/kokoro-tts/audio/speech
TTS_MODEL=kokoro-tts
TTS_VOICE=af_bella
# TTS_TIMEOUT=30
# TTS_MAX_RETRIES=2

# --- Hermes ------------------------------------------------------------------------
# How XENIO launches Hermes. XENIO speaks ACP (JSON-RPC over stdio) to this process.
# Hermes needs no URL or API key from XENIO: it uses its own config (hermes setup).
# HERMES_COMMAND=hermes acp
# HERMES_STARTUP_TIMEOUT=120
# HERMES_TURN_TIMEOUT=600
# Folder Hermes works in for XENIO (terminal default directory).
# XENIO_WORKSPACE=C:\Users\you\Xenio
# Your own folders (home, Desktop, Documents, Downloads, Pictures, Music, Videos, the workspace, temp)
# allow creating/editing files without asking. Add more trusted folders here (; separated):
# XENIO_ALLOWED_DIRS=D:\Projects;E:\Work
# Continue the same Hermes conversation across restarts.
# XENIO_RESUME_SESSION=true
# Seconds to wait for your yes/no on a permission prompt before denying.
# XENIO_PERMISSION_TIMEOUT=120

# --- Web and browser -------------------------------------------------------------------
# Show Hermes' own automation browser window while it works (pages you ask to SEE always open
# in your normal browser either way).
# XENIO_SHOW_BROWSER=false
# Size limit for downloads, in MB.
# XENIO_DOWNLOAD_MAX_MB=200

# --- Personal context (V4) -----------------------------------------------------------
# Google Calendar + Gmail: no key here - run `python -m app.main --connect-google` (see
# docs/PERSONAL_INTEGRATIONS.md). Your GitHub login, for "my repositories" before `gh auth login`:
# XENIO_GITHUB_USER=your-github-login
# Himalaya account to read email from (empty = Himalaya's default account):
# XENIO_HIMALAYA_ACCOUNT=
# Run due scheduled checks (Hermes cron) while XENIO is open:
# XENIO_PROACTIVE=true

# --- Voice ---------------------------------------------------------------------------
# XENIO_WAKE_PHRASE=hey xenio
# XENIO_WAKE_NAME_ONLY=true       # also wake on just "Xenio"
# XENIO_STOP_PHRASES=xenio stop,stop xenio,xenio cancel,xenio abort   # interrupt (just the name works too; while
#                                 # XENIO works silently, a bare "stop" / "abort" / "cancel" also stops it)
# XENIO_TALK_OVER=true            # interrupt by just talking; auto-enabled only when there is no echo (headphones)
# XENIO_WAKE_SENSITIVITY=0.5      # 0..1, higher = stricter
# XENIO_BARGE_IN=true
# XENIO_INPUT_DEVICE=             # device index or name; blank = WASAPI default mic
# XENIO_OUTPUT_DEVICE=            # blank = system default speaker
# XENIO_SILENCE_SECONDS=1.0       # pause that ends your command (loudness endpointing, when the VAD is off)
# XENIO_MAX_RECORD_SECONDS=15
# XENIO_LISTEN_TIMEOUT=6          # how long to wait for you to start speaking
# XENIO_SPEECH_THRESHOLD=         # blank = calibrate from your wake phrase; or a fixed RMS level (see --mic-test)
# XENIO_FOLLOW_UP_SECONDS=8       # keep listening after a reply without the wake word (0 = off)
# XENIO_VOICE_BRIEF=true          # ask Hermes for short spoken answers in voice mode
# Real-time conversation (all on by default):
# XENIO_VAD=true                  # Silero voice-activity detection (local) decides when you are speaking
# XENIO_EARLY_TRANSCRIBE=true     # transcribe at your first pause; a finished sentence ends your turn right away
# XENIO_VAD_SILENCE_SECONDS=0.55  # shortest pause that ends a finished-sounding sentence
# XENIO_TURN_PATIENCE_SECONDS=2.0 # pause allowed mid-sentence ("open the... downloads folder"); raise if cut off
# XENIO_STREAM_REPLIES=true       # speak each sentence as soon as Hermes has written it
# XENIO_ACKNOWLEDGE=true          # "One moment." / "Checking your calendar." while Hermes works
# XENIO_ACK_DELAY_SECONDS=0.3     # ...if the answer has not started by then
# XENIO_STT_HEDGE_SECONDS=3.0     # send a second transcription request if the first is slower (0 = off)
# XENIO_STT_ENGINE=cloud          # cloud = nabh Whisper | local = on-device Moonshine (fast, but poor with accents)

# --- Screen vision (V5, all optional) -----------------------------------------------------
# XENIO_VISION=true               # false = XENIO cannot look at the screen
# XENIO_VISION_PROVIDER=main      # main = your main Hermes model, no fallback | auto = Hermes' routing (may cost) | openai-compatible
# XENIO_VISION_MODEL=             # blank = the main model
# XENIO_VISION_MAX_EDGE=1600      # screenshot size sent to the model (long side, pixels)
# XENIO_VISION_API_URL=           # openai-compatible only, e.g. https://.../v1/chat/completions
# XENIO_VISION_API_KEY=           # openai-compatible only

# --- Housekeeping -----------------------------------------------------------------------
# XENIO_DATA_DIR=                 # default %LOCALAPPDATA%\xenio (logs, models, session)
# XENIO_LOG_LEVEL=INFO
